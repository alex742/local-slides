{
  "name": "local-slides",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "scripts": {
    "predev": "npm run build:player",
    "dev": "vite",
    "build:player": "node scripts/build-player.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "preview": "vite preview",
    "lint": "eslint src tests vite.config.ts playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:capture": "node scripts/verify-capture.mjs && node scripts/verify-capture-failures.mjs",
    "check:docs": "node scripts/documentation.mjs --check",
    "test:static": "node scripts/verify-static.mjs",
    "format": "prettier --write src tests scripts experiments .github '*.config.*' package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check src tests scripts experiments .github '*.config.*' package.json tsconfig.json .prettierrc.json"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@tiptap/extension-color": "3.34.0",
    "@tiptap/extension-font-family": "3.34.0",
    "@tiptap/extension-text-align": "3.34.0",
    "@tiptap/extension-text-style": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "codemirror": "6.0.2",
    "dompurify": "3.4.18",
    "fflate": "0.8.3",
    "html-to-image": "1.11.13",
    "jspdf": "4.2.1",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-moveable": "0.56.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "pdf-lib": "1.17.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
